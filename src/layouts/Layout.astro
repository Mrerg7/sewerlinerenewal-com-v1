---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'SewerLineRenewal.com | Premium Domain for Sale | Desert Rich',
  description = 'SewerLineRenewal.com is available now. Exact-match premium .com for trenchless sewer rehabilitation. Make an offer — escrow transfer through Desert Rich.',
  image = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/a1f14e7d-c102-465f-93b3-ed59066ef300/public',
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'sewerlinerenewal.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('slr-theme');
          if (t !== 'dark' && t !== 'light') {
            t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="hKkaw4KhwZBeyPeNCeDVPmh-kLOQ94H65dGmHxPSAn8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#0c3d6e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Sora:wght@500;600;700&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="SewerLineRenewal.com name lockup" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body class="bg-bg text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-navy focus:px-4 focus:py-3 focus:text-on-navy"
      >Skip to content</a
    >
    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
        <a href="/" class="font-display text-base font-semibold tracking-tight sm:text-lg">
          SewerLine<span class="text-pipe">Renewal</span><span class="text-muted">.com</span>
        </a>
        <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
          <a href="/guide" class="text-sm font-medium text-muted hover:text-ink">Buyer's guide</a>
          <a href="/#transfer" class="text-sm font-medium text-muted hover:text-ink">Transfer</a>
          <a href="/#offer" class="text-sm font-medium text-muted hover:text-ink">Offer</a>
        </nav>
        <div class="flex items-center gap-2">
          <button
            type="button"
            data-theme-toggle
            class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line"
            aria-label="Switch theme"
          >
            <span aria-hidden="true" data-theme-icon>◐</span>
          </button>
          <a
            href="/#offer"
            data-cta="header-offer"
            class="hidden h-12 items-center rounded-full bg-navy px-5 text-sm font-semibold text-on-navy hover:bg-navy-hover md:inline-flex"
            >Make an offer</a
          >
          <button
            type="button"
            data-nav-toggle
            class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line md:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            Menu
          </button>
        </div>
      </div>
      <nav id="mobile-nav" data-nav hidden class="border-t border-line bg-surface px-5 py-3 md:hidden">
        <a href="/guide" class="flex h-12 items-center text-base font-medium">Buyer's guide</a>
        <a href="/#transfer" class="flex h-12 items-center text-base font-medium">Transfer</a>
        <a href="/#offer" class="flex h-12 items-center text-base font-medium">Offer</a>
        <a href="mailto:sales@desertrich.com" data-cta="mobile-email" class="flex h-12 items-center text-base font-medium text-pipe"
          >Contact the broker</a
        >
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line bg-surface">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-3">
        <div>
          <p class="font-display text-lg font-semibold">
            SewerLine<span class="text-pipe">Renewal</span>.com
          </p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            One exact-match .com. Brokered by Desert Rich. Not a marketplace inventory item that restocks.
          </p>
        </div>
        <div class="text-sm">
          <p class="font-semibold">On this site</p>
          <ul class="mt-3 space-y-2 text-muted">
            <li><a href="/#why" class="hover:text-ink">Why the name</a></li>
            <li><a href="/#transfer" class="hover:text-ink">Transfer</a></li>
            <li><a href="/guide" class="hover:text-ink">Buyer's guide</a></li>
          </ul>
        </div>
        <div class="text-sm">
          <p class="font-semibold">Broker</p>
          <a
            href="mailto:sales@desertrich.com"
            data-cta="footer-email"
            class="mt-3 inline-flex h-12 items-center text-pipe hover:underline">sales@desertrich.com</a
          >
        </div>
      </div>
      <p class="mx-auto max-w-6xl px-5 pb-28 text-xs leading-relaxed text-muted md:pb-10">
        This website is for demonstration and informational purposes only. It does not constitute an offer of
        services, a commitment to deploy, or a guarantee of outcomes — including search rankings. All references
        to industry practice are based on publicly available information and are subject to change. Domain
        transfer is completed only under a written agreement and escrow.
      </p>
    </footer>

    <div class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 p-3 backdrop-blur md:hidden">
      <a
        href="/#offer"
        data-cta="sticky-offer"
        class="flex h-12 items-center justify-center rounded-full bg-navy text-sm font-semibold text-on-navy"
        >Make an offer</a
      >
    </div>

    <div id="exit" hidden class="fixed inset-0 z-50 flex items-end justify-center bg-ink/40 p-4 sm:items-center">
      <div role="dialog" aria-modal="true" aria-labelledby="exit-title" class="w-full max-w-md rounded-2xl border border-line bg-surface p-6 shadow-plaque">
        <div class="flex items-start justify-between gap-4">
          <h2 id="exit-title" class="font-display text-xl font-semibold">Before you go</h2>
          <button type="button" data-exit-close class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line" aria-label="Close">
            Close
          </button>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Ask for the one-page transfer outline: escrow, auth code, and how DNS is handed over. No discount theater.
        </p>
        <form id="exit-form" class="mt-4 flex flex-col gap-3 sm:flex-row">
          <label class="sr-only" for="exit-email">Email</label>
          <input id="exit-email" type="email" required placeholder="you@company.com" class="h-12 flex-1 rounded-full border border-line bg-bg px-4 text-base" />
          <button type="submit" data-cta="exit-outline" class="inline-flex h-12 items-center justify-center rounded-full bg-navy px-5 text-sm font-semibold text-on-navy">
            Request outline
          </button>
        </form>
        <p id="exit-done" hidden class="mt-4 text-sm">Draft opened to sales@desertrich.com.</p>
      </div>
    </div>
    <script src="/site.js" defer></script>
  </body>
</html>

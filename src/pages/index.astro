---
import Layout from '../layouts/Layout.astro';

const IMAGE =
  'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/a1f14e7d-c102-465f-93b3-ed59066ef300/public';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sewerlinerenewal.com/#broker',
      name: 'Desert Rich',
      email: 'sales@desertrich.com',
      url: 'https://sewerlinerenewal.com',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sewerlinerenewal.com/#website',
      name: 'sewerlinerenewal.com',
      url: 'https://sewerlinerenewal.com',
      description:
        'Exact-match .com domain for sale for trenchless sewer rehabilitation.',
      publisher: { '@id': 'https://sewerlinerenewal.com/#broker' },
    },
    {
      '@type': 'Product',
      name: 'sewerlinerenewal.com',
      description:
        'Exact-match .com domain name for sale. Sixteen letters, no hyphen, category language for sewer line renewal.',
      image: IMAGE,
      category: 'Domain name',
      brand: { '@type': 'Brand', name: 'sewerlinerenewal.com' },
      offers: {
        '@type': 'Offer',
        url: 'https://sewerlinerenewal.com',
        availability: 'https://schema.org/InStock',
        priceCurrency: 'USD',
        seller: { '@id': 'https://sewerlinerenewal.com/#broker' },
        description: 'Price on request. Serious offers reviewed by the broker.',
      },
    },
  ],
};

const reasons = [
  ['01', 'It is the phrase customers already use', '“Sewer line renewal” is how the job is said on a call, a bid, and a search. The domain does not ask anyone to learn a coined brand.'],
  ['02', 'It is not locked to a city', 'No metro in the string. A contractor in Phoenix, a lining crew in the Midwest, or a supplier selling nationally can all wear it.'],
  ['03', 'It reads on a truck door', 'Sixteen letters, two real words plus “line,” no hyphen, no number. The .com is the version people still type when they are not sure.'],
];

const buyers = [
  ['Trenchless contractors', 'CIPP lining, pipe bursting, and spot repair crews that want the category, not a founder’s surname.'],
  ['Liner and equipment makers', 'A destination for specs, training, and the contractors who buy the materials.'],
  ['Municipal service brands', 'Utilities and public-works vendors whose work is rehabilitation, not open-cut replacement.'],
  ['Multi-city operators', 'One national name instead of a stack of city domains that never quite match.'],
];

const steps = [
  ['Offer', 'Name, number, timeline, and the entity that would hold the name.'],
  ['Terms', 'The broker replies, usually within one business day, with what is and is not included.'],
  ['Escrow', 'Funds sit with Escrow.com or counsel both sides accept. No wire to a personal account.'],
  ['Push', 'Auth code or registrar push, then a planned DNS cut so a live site does not go dark.'],
];

const faqs = [
  ['Is a price published?', 'No. A public sticker price invites lowball noise and anchors the wrong number. Send a figure with how you would use the name.'],
  ['Can I buy it today?', 'Yes, if terms and escrow clear. “Buy now” here means a clean offer and a standard transfer, not a shopping-cart checkout.'],
  ['Do you lease the domain?', 'Lease-to-own can be discussed. It is not the default. Say so in the note if that is the structure you need.'],
  ['Will this rank me first for sewer line renewal?', 'No. The name matches the phrase. Rankings are not sold with it and are not guaranteed.'],
  ['Who answers?', 'Desert Rich, at sales@desertrich.com. The inquiry goes to a person, not a parked-page lead mill.'],
];
---

<Layout
  title="SewerLineRenewal.com | Premium Domain for Sale | Desert Rich"
  description="SewerLineRenewal.com is available now. Exact-match premium .com for trenchless sewer rehabilitation. Make an offer — escrow transfer through Desert Rich."
  jsonLd={jsonLd}
>
  <section class="rise mx-auto grid max-w-6xl items-center gap-12 px-5 pt-12 pb-16 lg:grid-cols-12 lg:pt-16">
    <div class="lg:col-span-7">
      <p class="text-xs font-semibold tracking-widest text-pipe uppercase">Premium .com for sale</p>
      <h1 class="mt-4 font-display text-4xl leading-none font-semibold tracking-tight sm:text-6xl">
        <span class="block">SewerLine</span>
        <span class="mt-1 block"><span class="text-pipe">Renewal</span><span class="text-muted">.com</span></span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        The exact-match name for companies that renew sewer lines — cured-in-place lining, pipe bursting, and
        municipal rehabilitation. Clear in a bid packet. Clear in search.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#offer" data-cta="hero-offer" class="inline-flex h-12 items-center rounded-full bg-navy px-6 text-sm font-semibold text-on-navy hover:bg-navy-hover">Make an offer</a>
        <a href="mailto:sales@desertrich.com" data-cta="hero-agent" class="inline-flex h-12 items-center rounded-full border border-line bg-surface px-6 text-sm font-semibold">Contact the broker</a>
      </div>
      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-6 sm:grid-cols-4">
        <div><dt class="text-xs tracking-widest text-muted uppercase">TLD</dt><dd class="mt-1 font-display text-xl font-semibold">.com</dd></div>
        <div><dt class="text-xs tracking-widest text-muted uppercase">Letters</dt><dd class="mt-1 font-display text-xl font-semibold">16</dd></div>
        <div><dt class="text-xs tracking-widest text-muted uppercase">Hyphen</dt><dd class="mt-1 font-display text-xl font-semibold">None</dd></div>
        <div><dt class="text-xs tracking-widest text-muted uppercase">Owner</dt><dd class="mt-1 font-display text-xl font-semibold">One</dd></div>
      </dl>
    </div>
    <figure class="rounded-2xl border border-line bg-plaque p-3 shadow-plaque lg:col-span-5">
      <img
        src={IMAGE}
        alt="Sewer Line Renewal emblem: a blue liner inside a cut pipe, with the wordmark SewerLineRenewal.com on concrete"
        width="1600"
        height="900"
        decoding="async"
        fetchpriority="high"
        class="h-auto w-full rounded-xl"
      />
      <figcaption class="flex items-center justify-between px-2 pt-3 pb-1 text-xs text-muted">
        <span>Name lockup</span><span>Available</span>
      </figcaption>
    </figure>
  </section>

  <section id="why" class="bg-band text-band-fg">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="font-display text-3xl font-semibold tracking-tight">Why this string of letters</h2>
        <p class="mt-4 text-sm leading-relaxed text-band-muted">
          Cured-in-place pipe and bursting let cities renew sewer lines without opening the street. Plenty of those
          companies are still named after a person. This domain names the work.
        </p>
      </div>
      <ol class="space-y-8 lg:col-span-8">
        {reasons.map(([n, title, body]) => (
          <li class="grid grid-cols-[auto_1fr] gap-4">
            <span class="font-display text-sm text-band-muted">{n}</span>
            <div>
              <h3 class="font-display text-xl font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-band-muted">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="font-display text-3xl font-semibold tracking-tight">Who it fits</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Not a generic “premium domain” pitch. The buyer is someone who already does this work, or sells to someone who does.
        </p>
        <a href="/guide" class="mt-6 inline-flex h-12 items-center text-sm font-semibold text-pipe hover:underline">Read the buyer’s guide</a>
      </div>
      <ul class="divide-y divide-line border-y border-line lg:col-span-8">
        {buyers.map(([title, body]) => (
          <li class="grid gap-2 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
            <h3 class="font-display text-lg font-semibold">{title}</h3>
            <p class="text-sm leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="transfer" class="border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="font-display text-3xl font-semibold tracking-tight">How the name changes hands</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        Standard registrar transfer. Escrow before the auth code moves. No countdown clock, because there is one name and it is either available or it is not.
      </p>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map(([title, body], i) => (
          <li class="rounded-2xl border border-line bg-bg p-5">
            <p class="font-display text-sm text-pipe">0{i + 1}</p>
            <h3 class="mt-3 font-display text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ol>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
        <li>Escrow.com or agreed counsel</li>
        <li>Written agreement before push</li>
        <li>DNS cutover planned, not improvised</li>
      </ul>
    </div>
  </section>

  <section id="offer" class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="font-display text-3xl font-semibold tracking-tight">Make an offer</h2>
      <p class="mt-4 text-sm leading-relaxed text-muted">
        Price is on request. A short note with a number, a use, and a timeline gets a faster answer than a blank “how much?” The form opens your email to the broker. It does not post the offer to a database.
      </p>
      <p class="mt-6 text-sm">Status: <span class="font-semibold">available</span></p>
    </div>
    <div class="lg:col-span-8">
      <form id="offer-form" class="rounded-2xl border border-line bg-surface p-6 sm:p-8" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-medium">Name
            <input required name="name" autocomplete="name" class="mt-2 h-12 w-full rounded-xl border border-line bg-bg px-3 text-base" />
          </label>
          <label class="block text-sm font-medium">Email
            <input required type="email" name="email" autocomplete="email" class="mt-2 h-12 w-full rounded-xl border border-line bg-bg px-3 text-base" />
          </label>
          <label class="block text-sm font-medium">Company
            <input name="company" autocomplete="organization" class="mt-2 h-12 w-full rounded-xl border border-line bg-bg px-3 text-base" />
          </label>
          <label class="block text-sm font-medium">Offer in USD
            <input name="offer" inputmode="numeric" placeholder="Optional" class="mt-2 h-12 w-full rounded-xl border border-line bg-bg px-3 text-base" />
          </label>
        </div>
        <fieldset class="mt-5">
          <legend class="text-sm font-medium">What do you need?</legend>
          <div class="mt-3 flex flex-wrap gap-2 text-sm font-medium">
            <label class="inline-flex h-12 items-center rounded-full border border-line px-4"><input type="radio" name="intent" value="Make an offer" checked class="mr-2" />Make an offer</label>
            <label class="inline-flex h-12 items-center rounded-full border border-line px-4"><input type="radio" name="intent" value="Ask a question" class="mr-2" />Ask a question</label>
            <label class="inline-flex h-12 items-center rounded-full border border-line px-4"><input type="radio" name="intent" value="Discuss terms" class="mr-2" />Discuss terms</label>
          </div>
        </fieldset>
        <label class="mt-5 block text-sm font-medium">Note
          <textarea name="message" rows="4" placeholder="Use of the name, timeline, and the entity that would take title." class="mt-2 w-full rounded-xl border border-line bg-bg px-3 py-3 text-base leading-relaxed"></textarea>
        </label>
        <p data-error hidden class="mt-4 text-sm text-danger" role="alert"></p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button type="submit" data-cta="offer-submit" class="inline-flex h-12 items-center rounded-full bg-navy px-6 text-sm font-semibold text-on-navy hover:bg-navy-hover">Send to the broker</button>
          <a href="mailto:sales@desertrich.com" data-cta="offer-mailto" class="text-sm font-medium text-pipe hover:underline">Or email sales@desertrich.com</a>
        </div>
      </form>
      <div id="offer-sent" hidden class="rounded-2xl border border-line bg-surface p-6 sm:p-8" role="status">
        <p class="font-display text-2xl font-semibold">Offer drafted</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">Your mail app should be open to sales@desertrich.com. If it did not launch, copy the note.</p>
        <pre id="offer-pre" class="mt-5 overflow-x-auto rounded-xl bg-plaque p-4 text-sm leading-relaxed whitespace-pre-wrap"></pre>
        <div class="mt-5 flex flex-wrap gap-3">
          <button type="button" id="offer-copy" class="inline-flex h-12 items-center rounded-full bg-navy px-5 text-sm font-semibold text-on-navy">Copy note</button>
          <button type="button" id="offer-edit" class="inline-flex h-12 items-center rounded-full border border-line px-5 text-sm font-semibold">Edit</button>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16">
    <h2 class="font-display text-3xl font-semibold tracking-tight">Questions</h2>
    <div class="mt-6 divide-y divide-line border-y border-line">
      {faqs.map(([q, a]) => (
        <details class="group py-1">
          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-3 font-medium">
            {q}
            <span class="text-muted group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="max-w-3xl pb-4 text-sm leading-relaxed text-muted">{a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
